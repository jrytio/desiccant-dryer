esphome/secrets.yaml
esphome/.esphome/
# Docker builds mount the repo root as /config, so ESPHome caches toolchains
# (~2 GB of ESP-IDF and PlatformIO) here as well.
/.esphome/
.ci-cache/
*.bin
.DS_Store
.superpowers/
esphome/.gitignore
__pycache__/
hardware/out/
# KiCad local view state, and the ERC/DRC reports check and board.drc_report write beside the files.
hardware/*/*.kicad_prl
*.rpt
# Freerouting intermediates (route.py removes them; ignore if a run is interrupted).
*.dsn
*.ses
.freerouting/
