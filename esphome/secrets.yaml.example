# Used by the hand-flashed test builds only (packages/dev-secrets.yaml);
# the production release carries no secrets.
# One WiFi pair per site; the board joins whichever is in range. Quote each
# SSID exactly as the access point broadcasts it, trailing spaces included.
wifi_home_ssid: "home-iot-ssid"
wifi_home_password: "home-iot-password"
wifi_workshop_ssid: "workshop-iot-ssid "   # the real one ends in a space; keep it inside the quotes
wifi_workshop_password: "workshop-iot-password"
api_key: "4H6XHMHjh2YJ+LwqMnMNCZICkCXoUsrxyEge7vLiOYk="   # replace: openssl rand -base64 32
ota_password: "ota-password"
