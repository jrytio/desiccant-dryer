# One WiFi pair per site; the board joins whichever is in range. Quote each
# SSID exactly as the access point broadcasts it, trailing spaces included.
wifi_home_ssid: "home-iot-ssid"
wifi_home_password: "home-iot-password"
wifi_workshop_ssid: "workshop-iot-ssid"
wifi_workshop_password: "workshop-iot-password"
ap_password: "fallback-ap-password"
api_key: "base64-32-byte-key"        # esphome: openssl rand -base64 32
ota_password: "ota-password"
